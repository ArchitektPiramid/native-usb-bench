{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NativeUSB Bench",
  "version": "0.1.0",
  "identifier": "dev.nativeusb.bench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NativeUSB Bench \u2014 Vendor WinUSB",
        "width": 1060,
        "height": 800,
        "minWidth": 740,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
